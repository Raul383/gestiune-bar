<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane id="interfataMeseView" styleClass="app-root" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.restaurant.controller.InterfataMeseController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="page-header">
            <Button fx:id="btnDashboard" text="Înapoi la dashboard"
                    styleClass="secondary-button" onAction="#backToDashboard" />
            <Label text="Interfața meselor" styleClass="section-title" />
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.67" orientation="HORIZONTAL"  minWidth="0" minHeight="0">
            <!-- Partea stângă: canvas alb -->
            <AnchorPane fx:id="canvasPane" minWidth="0" minHeight="0" style="-fx-background-color: white;">
                <Canvas fx:id="restaurantCanvas"
                        AnchorPane.topAnchor="0.0"
                        AnchorPane.rightAnchor="0.0"
                        AnchorPane.bottomAnchor="0.0"
                        AnchorPane.leftAnchor="0.0" />
            </AnchorPane>
            <ScrollPane  fitToWidth="true" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent;" vbarPolicy="AS_NEEDED">
                <!-- Partea dreaptă: meniu debug gri -->
                <VBox fx:id="menuPanel" prefWidth="300" spacing="10" style="-fx-background-color: #dddddd;">
                    <!-- Flip-flop: Masă / Obstacol -->
                    <Label style="-fx-font-weight: bold;" text="Tip element:" />
                    <HBox spacing="15">
                        <RadioButton fx:id="radioMasa" focusTraversable="false" selected="true" text="Masă" />
                        <RadioButton fx:id="radioObstacol" focusTraversable="false" text="Obstacol" />
                    </HBox>

                    <Label style="-fx-font-weight: bold; -fx-padding: 10;" text="Panou de control" />

                    <!-- Rândul 1: Select, Draw, Axe, Save -->
                    <HBox spacing="10" style="-fx-padding: 10;">
                        <ToggleButton fx:id="btnSelect" focusTraversable="false" minWidth="35.0" prefWidth="60" text="🖱" />
                        <ToggleButton fx:id="btnDraw" focusTraversable="false" minWidth="35.0" prefWidth="60" text="✏" />
                        <Button fx:id="btnResize" focusTraversable="false" minWidth="35.0" prefWidth="60" text="↔" />
                        <Button fx:id="btnSave" focusTraversable="false" minWidth="35.0" prefWidth="60" text="🗁" />
                    </HBox>

                    <Separator />

                    <!-- Panoul secundar: apare doar când Draw este selectat -->
                    <VBox fx:id="drawOptionsPanel" managed="false" spacing="10" style="-fx-padding: 10;" visible="false">
                        <Label style="-fx-font-weight: bold;" text="Formă de desenat:" />
                        <HBox spacing="10">
                            <ToggleButton fx:id="btnCircle" focusTraversable="false" minWidth="35.0" prefWidth="60" text="○" />
                            <ToggleButton fx:id="btnRectangle" focusTraversable="false" minWidth="35.0" prefWidth="60" text="□" />
                        </HBox>

                        <!-- Parametri pentru CERC -->
                        <VBox fx:id="circleParams" managed="true" spacing="5" visible="true">
                            <Label text="Rază (m):" />
                            <Slider fx:id="sliderRaza" max="5.0" min="0.1" showTickLabels="true" showTickMarks="true" value="1.0" />
                            <Label fx:id="labelRaza" text="1.0 m" />
                        </VBox>

                        <!-- Parametri pentru PĂTRAT -->
                        <VBox fx:id="rectangleParams" managed="false" spacing="5" visible="false">
                            <Label text="Lungime (m):" />
                            <Slider fx:id="sliderLungime" max="5.0" min="0.1" showTickLabels="true" showTickMarks="true" value="1.0" />
                            <Label fx:id="labelLungime" text="1.0 m" />
                            <Label text="Lățime (m):" />
                            <Slider fx:id="sliderLatime" max="5.0" min="0.1" showTickLabels="true" showTickMarks="true" value="1.0" />
                            <Label fx:id="labelLatime" text="1.0 m" />
                        </VBox>
                    </VBox>
                
                    <Separator />

                    <!-- Zona de info / debug -->
                    <Label fx:id="infoLabel" style="-fx-padding: 10;" text="Selectează o formă..." wrapText="true" />
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>
